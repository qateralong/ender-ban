<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.ufhs</groupId>
  <artifactId>EnderBan</artifactId>
  <version>2.0.1</version>
  <name>EnderBan</name>
  <description>Plugin for disabling items in the Ender Chest (Minecraft 26.1 - 26.3, all Bukkit-based cores)</description>

  <properties>
    <!--
      Minecraft/Paper dropped the old "1.2x" numbering for the year-based
      "26.x" scheme (1.21.11 was the last release under the old scheme;
      26.1 is the first under the new one). Bytecode compiled for release
      17 still loads fine on these servers even though their own jars now
      require JDK 25 to run - the JVM stays backward compatible with older
      class files, so there's no reason to raise this.
    -->
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <repositories>
    <repository>
      <id>papermc-repo</id>
      <url>https://repo.papermc.io/repository/maven-public/</url>
    </repository>
  </repositories>

  <dependencies>
    <!--
      Deliberately pinned to the OLDEST supported Paper API (26.1.2) rather
      than the newest. Bukkit's public API only grows across versions, so
      code compiled against 26.1.2 keeps working unmodified on every later
      26.x release. Pinning to the newest API instead would risk calling
      methods that don't exist yet on older servers.

      Paper no longer publishes a mutable "-R0.1-SNAPSHOT" alias for the
      26.x line - each build is an immutable, exact version now
      (<mc version>.build.<n>-<channel>). 26.1.1 never reached the
      "stable" channel, so 26.1.2 build 74 is the oldest stable build
      available. 26.3 is the newest Minecraft release (confirmed via
      Fabric's meta API as of 2026-09-17) but PaperMC hadn't cut a stable
      build for it yet at that date (alpha/rc only) - bump this once they
      do, the plugin needs no code changes for it either way.
    -->
    <dependency>
      <groupId>io.papermc.paper</groupId>
      <artifactId>paper-api</artifactId>
      <version>26.1.2.build.74-stable</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>EnderBan-${project.version}</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.11.0</version>
        <configuration>
          <release>${maven.compiler.release}</release>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
